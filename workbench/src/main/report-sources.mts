/** Read-only source catalog. Report scripts never receive app privileges. */
export function reportSources(html:string, sourceUrl?:string|null):string[] {
 const urls=new Set<string>();
 const add=(raw:string)=>{try{const decoded=raw.replace(/&amp;/gi,'&').replace(/&#(?:x([0-9a-f]+)|(\d+));/gi,(_,hex,decimal)=>String.fromCodePoint(Math.min(0x10ffff,parseInt(hex??decimal,hex?16:10))));const url=new URL(decoded);if(['http:','https:'].includes(url.protocol)&&!url.username&&!url.password&&url.href.length<=4096)urls.add(url.href);}catch{}};
 if(sourceUrl)add(sourceUrl);
 for(const match of html.matchAll(/\bhref\s*=\s*(?:"([^"]+)"|'([^']+)')/gi)){if(urls.size>=100)break;add(match[1]??match[2]);}
 return [...urls];
}

export interface BoundSourcePage {
 html:string;hash:string;allowWrites?:boolean;api:Record<string,unknown>;storage:Record<string,string>;stateHash:string|null;title:string;
}
/** The bridge has no network API. It can request only the fixed source's validated note/selection writes. */
export function boundSourceFrame(page:BoundSourcePage,basePath:string,relativePath:string):string {
 const assetPrefix=`${basePath}/file${relativePath.startsWith('public/')?'/public':''}`;
 const rewrite=(value:unknown):unknown=>{
  if(typeof value==='string'&&value.startsWith('/')&&!value.startsWith('//')&&!value.startsWith('/api/'))return assetPrefix+value;
  if(Array.isArray(value))return value.map(rewrite);
  if(value&&typeof value==='object')return Object.fromEntries(Object.entries(value).map(([key,item])=>[key,rewrite(item)]));
  return value;
 };
 const config=JSON.stringify({basePath,assetPrefix,relativePath,publicPrefix:relativePath.startsWith('public/'),allowWrites:page.allowWrites===true,api:rewrite(page.api),storage:page.storage}).replace(/</g,'\\u003c');
 const bootstrap=`(()=>{const config=${config},pending=new Map(),blobs=new Map(),nativeObjectURL=URL.createObjectURL.bind(URL);URL.createObjectURL=blob=>{const url=nativeObjectURL(blob);blobs.set(url,blob);return url;};let serial=0;const send=(path,body)=>new Promise((resolve,reject)=>{const id=String(++serial);pending.set(id,{resolve,reject});parent.postMessage({kind:'nova-source-request',id,request:{method:'POST',path,body}},'*');setTimeout(()=>{const p=pending.get(id);if(p){pending.delete(id);p.reject(Error('保存响应超时，当前输入保留'));}},15000);});addEventListener('message',event=>{if(event.source!==parent||event.data?.kind!=='nova-source-result')return;const p=pending.get(event.data.id);if(!p)return;pending.delete(event.data.id);event.data.ok?p.resolve(event.data.data):p.reject(Error(event.data.message||'保存未完成'));});const route=value=>{const u=new URL(String(value),location.href);if(u.pathname.startsWith(config.assetPrefix+'/'))return u.pathname.slice(config.assetPrefix.length);return u.pathname;};window.fetch=async(input,options={})=>{const key=route(input instanceof Request?input.url:input),method=String(options.method||'GET').toUpperCase();if(method==='GET'&&Object.hasOwn(config.api,key))return new Response(JSON.stringify(config.api[key]),{status:200,headers:{'Content-Type':'application/json'}});if(method==='POST'&&(/^\\/api\\/reviews\\/[A-Za-z0-9_-]+$/.test(key)||key==='/api/overall'||key==='/api/progress'||key==='/api/start-production'))return new Response(JSON.stringify(await send(key,JSON.parse(options.body))),{status:200,headers:{'Content-Type':'application/json'}});throw Error('此离线页面未取得该资源或操作：'+key);};const storage={...config.storage};Object.defineProperty(window,'localStorage',{value:{getItem:key=>Object.hasOwn(storage,String(key))?storage[String(key)]:null,setItem:(key,value)=>{if(!config.allowWrites)throw Error('原页面版本未通过保存桥校验，只读打开');storage[String(key)]=String(value);send('/storage',{key:String(key),value:String(value)}).catch(error=>parent.postMessage({kind:'nova-source-error',message:error.message},'*'));},removeItem:key=>{if(!config.allowWrites)throw Error('原页面版本未通过保存桥校验，只读打开');delete storage[String(key)];send('/storage',{key:String(key),value:null}).catch(error=>parent.postMessage({kind:'nova-source-error',message:error.message},'*'));},key:index=>Object.keys(storage)[index]??null,get length(){return Object.keys(storage).length;}}});document.addEventListener('click',event=>{const link=event.target.closest?.('a[href]');if(!link)return;const url=new URL(link.getAttribute('href'),location.href);if(url.hash&&url.pathname===location.pathname)return;const key=route(url.href);if(url.protocol==='blob:'&&blobs.has(url.href)){event.preventDefault();if(config.allowWrites)blobs.get(url.href).text().then(text=>parent.postMessage({kind:'nova-source-download',filename:link.download||'choices.json',text},'*'));return;}if(key==='/api/export'){event.preventDefault();if(config.allowWrites)send('/api/export',{}).then(result=>parent.postMessage({kind:'nova-source-download',filename:result.filename,text:result.exportText},'*'));return;}if(/\\.html?$/.test(key)){event.preventDefault();if(url.origin===location.origin){let relative=key.replace(/^\\//,'');if(relative==='review.html')relative='index.html';parent.postMessage({kind:'nova-source-navigate',relativePath:(config.publicPrefix?'public/':'')+relative},'*');}else parent.postMessage({kind:'nova-source-error',message:'该独立来源未包含在当前绑定包中。'},'*');}else if(/^https?:$/.test(url.protocol)&&url.origin!==location.origin){event.preventDefault();parent.postMessage({kind:'nova-source-error',message:'离线原页面未获得此外部来源；请通过资料来源核查。'},'*');}},true);let missing=0;document.addEventListener('error',event=>{if(event.target instanceof HTMLImageElement){missing++;event.target.alt='原包未提供此图片';parent.postMessage({kind:'nova-source-error',message:'当前页有 '+missing+' 张图片的原件未包含在来源包中。'},'*');}},true);})();`;
 // Freeze local root paths to this exact capability; page scripts remain confined to its opaque sandbox.
 let html=page.html.replace(/\b(src|href|poster)\s*=\s*(["'])\/(?!\/)/gi,(_,attribute:string,quote:string)=>attribute+'='+quote+assetPrefix+'/').replace(/url\(\s*(["']?)\/(?!\/)/gi,(_,quote:string)=>'url('+quote+assetPrefix+'/');
 const injection=`<base href="${basePath}/file/${relativePath.slice(0,relativePath.lastIndexOf('/')+1)}"><script>${bootstrap.replace(/<\/script/gi,'<\\/script')}</script>`;
 if(/<head\b[^>]*>/i.test(html))html=html.replace(/<head\b[^>]*>/i,m=>m+injection);else html=`<!doctype html><head>${injection}</head>${html}`;
 return html;
}
