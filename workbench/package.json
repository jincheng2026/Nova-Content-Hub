{
  "name": "nova-content-hub-workbench",
  "private": true,
  "version": "0.3.38",
  "type": "module",
  "main": "dist/main/index.mjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck:native": "tsc -p tsconfig.native.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "typecheck": "npm run typecheck:native && npm run typecheck:renderer",
    "build": "node scripts/build.mjs",
    "dist:local": "node scripts/dist.mjs --channel local --auth disabled",
    "dist:preview": "node scripts/dist.mjs --channel preview --auth disabled",
    "dist:preview:payload": "node scripts/dist.mjs --export-payload --channel preview --auth disabled",
    "dist:preview:universal": "node scripts/dist-universal.mjs",
    "dist:testing": "node scripts/dist.mjs --channel testing --auth required",
    "dist:production": "node scripts/dist.mjs --channel production --auth disabled",
    "start": "electron dist-desktop/auth-disabled",
    "test": "node --test test/*.test.mjs",
    "probe": "node scripts/probe.mjs",
    "probe:lifecycle": "node scripts/lifecycle-probe.mjs",
    "probe:cover": "node scripts/cover-probe.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@douyinfe/semi-ui-19": "2.104.0",
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5"
  }
}
