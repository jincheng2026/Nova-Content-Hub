{
  "name": "nova-content-hub-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "dist/main/index.mjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck:native": "tsc -p tsconfig.native.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "typecheck": "npm run typecheck:native && npm run typecheck:renderer",
    "build": "node scripts/build.mjs",
    "start": "electron ../dist-desktop/auth-required",
    "test": "node --test test/*.test.mjs",
    "probe": "node scripts/probe.mjs",
    "probe:lifecycle": "node scripts/lifecycle-probe.mjs",
    "probe:cover": "node scripts/cover-probe.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@douyinfe/semi-ui-19": "2.104.0",
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5"
  }
}
